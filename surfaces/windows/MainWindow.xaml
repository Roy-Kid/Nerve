<Window x:Class="Nerve.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nerve">
 <Grid x:Name="Root" Padding="12" RowSpacing="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" KeyDown="OnKeyDown">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="Counts" VerticalAlignment="Center" FontSize="13" Text="Connecting…"/>
   <Button Grid.Column="1" Click="CycleGroup" ToolTipService.ToolTip="Cycle grouping" AutomationProperties.Name="Cycle grouping"><SymbolIcon Symbol="Sort"/></Button>
   <ToggleButton x:Name="SettingsButton" Grid.Column="2" Click="ToggleSettings" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings"><SymbolIcon Symbol="Setting"/></ToggleButton>
   <Button Grid.Column="3" Click="QuitClicked" ToolTipService.ToolTip="Quit Nerve" AutomationProperties.Name="Quit Nerve"><FontIcon Glyph="&#xE7E8;"/></Button>
  </Grid>
  <InfoBar x:Name="Note" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Informational"/>
  <Grid Grid.Row="2">
   <ListView x:Name="Jobs" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="JobClicked"/>
   <StackPanel x:Name="Empty" Visibility="Collapsed" VerticalAlignment="Center" Spacing="8">
    <SymbolIcon Symbol="ViewAll" HorizontalAlignment="Center"/>
    <TextBlock x:Name="EmptyTitle" Text="Nothing running" HorizontalAlignment="Center" FontSize="16"/>
    <TextBlock x:Name="EmptyMessage" Text="Start an agent with the Nerve plugin to see its progress here." TextWrapping="Wrap" TextAlignment="Center"/>
   </StackPanel>
   <ScrollViewer x:Name="SettingsScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
   <StackPanel x:Name="SettingsPanel" Spacing="12">
    <TextBlock Text="Settings" Style="{StaticResource SubtitleTextBlockStyle}"/>
    <ToggleSwitch x:Name="Autostart" Header="Start at login" Toggled="PreferencesChanged"/>
    <ToggleSwitch x:Name="Toasts" Header="Ask notifications" Toggled="PreferencesChanged"/>
    <ToggleSwitch x:Name="Sound" Header="Notification sound" Toggled="PreferencesChanged"/>
    <TextBlock Text="Notifications appear when an agent needs you." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</Window>
